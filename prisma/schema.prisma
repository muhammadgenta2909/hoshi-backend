// Hoshi Backend — Prisma schema
// Domain Hoshi: platform menyimpan kartu fisik (vault) lalu mint NFT yang
// merepresentasikan kartu tsb ke wallet user.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Koneksi POOLED (PgBouncer) — dipakai aplikasi saat runtime.
  url = env("DATABASE_URL")

  // Koneksi DIRECT (unpooled) — WAJIB untuk `prisma migrate deploy`.
  // Migration menjalankan DDL dan mengambil advisory lock; lewat PgBouncer itu
  // bisa menggantung atau gagal. Di Neon: pakai host TANPA sufiks `-pooler`.
  // Untuk lokal cukup: DIRECT_URL="${DATABASE_URL}" (dotenv-expand).
  directUrl = env("DIRECT_URL")
}

// Status sebuah item kartu fisik di dalam vault.
enum VaultStatus {
  STORED // kartu fisik tersimpan di vault, belum diklaim user
  MINTING // sedang diklaim & proses mint berjalan (in-flight, tidak bisa diklaim lagi)
  MINTED // sudah diklaim user & NFT-nya sudah di-mint
  REDEEMED // user menukar NFT kembali jadi kartu fisik (out of POC scope)
}

// Status on-chain dari sebuah NFT yang sudah di-mint.
enum NftStatus {
  MINTED
  TRANSFERRED
  BURNED
}

// Status sebuah listing di marketplace sekunder.
enum ListingStatus {
  ACTIVE // dipajang & bisa dibeli
  SOLD // sudah terjual (buyer ter-set)
  CANCELLED // ditarik penjual
}

// Lembaga grading pada slab kartu (badge di UI + filter Grade & Grader).
enum Grader {
  PSA
  CGC
  BGS
}

// User dikenali dari wallet address (login-with-wallet).
model User {
  id            String  @id @default(cuid())
  walletAddress String  @unique
  // Nonce challenge untuk login berikutnya (di-set saat minta /auth/nonce,
  // dikosongkan setelah dipakai). Mencegah replay signature.
  nonce         String?
  displayName   String?
  role          String  @default("USER")
  email         String?
  passwordHash  String?

  /// Saldo in-app (Rupiah, base unit = rupiah utuh) hasil penjualan P2P — dikreditkan saat
  /// kartu user terjual (Flow B). BigInt untuk menghindari overflow uang. Kebenarannya dijaga
  /// bareng ledger `BalanceEntry` (increment field + insert entry dalam satu transaksi).
  /// Penarikan (withdraw) = fitur terpisah, belum ada di fase ini.
  balanceIdrx   BigInt  @default(0)

  // Profil publik opsional (halaman profil). Semua nullable: null = belum diisi.
  bio              String?
  twitter          String? // handle tanpa "@" — di-strip di DTO
  website          String?
  phoneCountryCode String? // format "+62" (divalidasi di DTO)
  phoneNumber      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nfts       Nft[]
  vaultItems VaultItem[]

  // Listing yang dijual / dibeli user ini (marketplace sekunder).
  listingsSelling Listing[] @relation("ListingSeller")
  listingsBought  Listing[] @relation("ListingBuyer")

  // Offer yang DIBUAT user ini (tab "Offers Made"). Offer yang DITERIMA user ini
  // dicari lewat listing.sellerId, bukan relasi langsung (tab "Offers Received").
  offersMade Offer[] @relation("OfferBuyer")

  // Feed aktivitas profil: baris di mana user jadi aktor (from) atau lawan (to).
  activityFrom Activity[] @relation("ActivityFrom")
  activityTo   Activity[] @relation("ActivityTo")

  // Pembelian pack gacha CollectorCrypt (ledger atribusi komisi).
  ccPackPurchases CcPackPurchase[]

  // Order pembayaran rupiah lewat IDRX (buku besar on-ramp).
  paymentOrders PaymentOrder[]

  // Mutasi saldo in-app (ledger append-only; audit tiap kredit/debit).
  balanceEntries BalanceEntry[]

  // Alamat pengiriman kartu fisik (redeem). Maks 5 per user (ditegakkan di service).
  shippingAddresses ShippingAddress[]

  // Thread support (user ↔ admin).
  supportThreads SupportThread[]

  // Thread pesan marketplace (pembeli ↔ penjual) di mana user ini jadi salah satu sisi.
  marketThreadsAsBuyer  MarketThread[] @relation("MarketThreadBuyer")
  marketThreadsAsSeller MarketThread[] @relation("MarketThreadSeller")

  @@map("users")
}

/// Ledger mutasi saldo in-app (append-only, tidak pernah di-update/hapus). Tiap kredit/debit
/// `User.balanceIdrx` menulis satu baris di sini DALAM transaksi yang sama → saldo & riwayat
/// tidak mungkin menyimpang. `refId` = kunci idempotensi (mis. merchantOrderId penjualan) supaya
/// callback/reconciler yang diulang tidak menggandakan kredit; `@@unique([reason, refId])`.
model BalanceEntry {
  id String @id @default(cuid())

  userId String
  // Restrict: baris ledger uang tidak boleh yatim gara-gara user dihapus.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Delta saldo (rupiah utuh). Positif = kredit (mis. hasil jual), negatif = debit.
  deltaIdrx BigInt

  /// Kenapa saldo berubah (mis. "P2P_SALE"). Bebas, tapi konsisten per sumber.
  reason String

  /// Kunci idempotensi opsional (mis. merchantOrderId). Kombinasi (reason, refId) unik.
  refId String?

  createdAt DateTime @default(now())

  @@unique([reason, refId])
  @@index([userId])
  @@map("balance_entries")
}

/// Alamat pengiriman kartu fisik milik user (untuk redeem). Cascade: alamat tidak
/// punya nilai audit sendiri, jadi ikut terhapus bila user-nya dihapus.
model ShippingAddress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  country          String
  street           String
  apt              String?
  state            String?
  city             String
  phoneCountryCode String?
  phoneNumber      String?
  zip              String
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@map("shipping_addresses")
}

// Katalog/template kartu (metadata kartu fisik yang di-vault Hoshi).
model Card {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  set         String?
  rarity      String?
  // Atribut bebas: [{ "trait_type": "Set", "value": "Base" }, ...]
  attributes  Json?
  // URL metadata JSON yang dipakai saat mint (fallback ke DEFAULT_METADATA_URI).
  metadataUri String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nfts       Nft[]
  vaultItems VaultItem[]
  listings   Listing[]

  @@map("cards")
}

// Catatan NFT yang sudah di-mint on-chain (devnet).
model Nft {
  id           String    @id @default(cuid())
  assetAddress String    @unique // alamat asset Metaplex Core
  ownerAddress String // wallet pemilik (snapshot saat mint)
  mintTx       String? // signature transaksi mint
  metadataUri  String?
  name         String?
  status       NftStatus @default(MINTED)

  cardId  String?
  // Restrict: hapus Card dilarang bila masih dirujuk NFT (cegah putus link diam-diam).
  card    Card?   @relation(fields: [cardId], references: [id], onDelete: Restrict)
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  vaultItem          VaultItem? // back-relation 1-1 (di-set saat klaim dari vault)
  marketplaceListing Listing?   @relation("ListingNft") // back-relation 1-1 (di-set saat buy marketplace)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerAddress])
  @@map("nfts")
}

// Di mana kartu fisik disimpan (custody/provider). Menjawab pertanyaan bisnis
// "inventory kita disimpan di vault mana". HOSHI = vault kelolaan sendiri (default).
enum StorageProvider {
  HOSHI
  COLLECTORCRYPT
  PWCC
  OTHER
}

// Instance kartu fisik di dalam vault.
model VaultItem {
  id           String      @id @default(cuid())
  serialNumber String?     @unique
  status       VaultStatus @default(STORED)

  // Custody: provider + label lokasi manusiawi (mis. "Jakarta Vault A",
  // "CollectorCrypt PWCC"). Diisi saat store, bisa diubah admin. Sebelumnya
  // lokasi HANYA ada sebagai teks bebas di Listing.vaultLocation (tidak
  // terstruktur & tidak per-item) — sekarang jadi sumber kebenaran per-item.
  storageProvider StorageProvider @default(HOSHI)
  vaultLocation   String?

  cardId String
  // Restrict: hapus Card dilarang bila masih ada vault item yang merujuknya.
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  ownerId String? // user yang mengklaim (null selama masih STORED)
  owner   User?   @relation(fields: [ownerId], references: [id])

  nftId String? @unique // NFT hasil mint (null sebelum diklaim)
  nft   Nft?    @relation(fields: [nftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([storageProvider])
  @@map("vault_items")
}

// Provenance vault sebuah listing: di vault siapa kartu fisiknya tersimpan.
// HOSHI = kartu kelolaan sendiri (default — semua listing lama otomatis HOSHI).
// COLLECTORCRYPT = hasil sync katalog publik CollectorCrypt; metadata milik
// mereka (di-refresh tiap sync), admin kita hanya mengedit HARGA di atasnya.
enum ListingSource {
  HOSHI
  COLLECTORCRYPT
}

// Satu listing kartu bergrade di marketplace sekunder.
// POC/MVP: field tampilan (grade, era, element, dll) di-denormalisasi ke baris ini
// supaya GET /marketplace langsung cocok dengan tipe `Listing` di frontend
// (lib/market.ts) — swap mock→API tanpa mapping. cardId opsional buat menautkan
// ke katalog nanti.
model Listing {
  id        String  @id @default(cuid())
  name      String
  set       String // MarketSet: Classic/Jungle/Promo/Rare/Evolving
  rarity    String // Tier: Common/Rare/Epic/Legendary/Legendary Rare
  image     String
  // Optional back art. Kept on the listing row so detail pages do not invent it.
  imageBack String?

  // Ekonomi (IDRX). Int cukup utk POC (< 2.1M IDRX); TODO: BigInt kalau harga kartu
  // riil > 2.1 miliar. Balik ke frontend sebagai number JSON apa adanya.
  priceIdrx         Int
  expectedValueIdrx Int
  buybackIdrx       Int @default(0) // > 0 ⇒ Hoshi-backed (badge HOSHI)

  // Field tampilan kartu bergrade (Figma).
  grade      String // "PSA 10"
  grader     Grader
  gradeScore Float // 8 / 9 / 9.5 / 10
  language   String // "English" | "Japan"
  era        String // "Scarlet & Violet", dst
  element    String // "Fire", "Water", dst
  category   String // "Special Illustration", dst
  views      Int    @default(0)

  // Detail-page data. Nullable while a listing is still a lightweight market row;
  // populated by seed/admin/create flows when real card metadata is available.
  certificate     String?
  vaultLocation   String?
  cardNumber      String?
  variant         String?
  contractAddress String?
  priceHistory    Json?
  offers          Json?

  status ListingStatus @default(ACTIVE)

  // ── Provenance vault + jejak sync CollectorCrypt ─────────────────────────
  // Badge "Hoshi vault" vs "CollectorCrypt vault" di frontend dirender dari
  // `source` — BUKAN lagi disimpulkan dari buybackIdrx > 0.
  source ListingSource @default(HOSHI)

  // Kunci upsert sync: alamat NFT (Solana asset) kartu di katalog CC.
  // @unique ⇒ re-sync meng-update baris yang sama, tidak pernah menduplikasi.
  ccNftAddress String? @unique

  // Snapshot harga listing CC dalam DOLAR UTUH (Float, BUKAN base unit 6-desimal:
  // kartu > $2.147 akan overflow Int32 kalau disimpan sebagai base unit).
  // Dipakai admin sebagai pembanding saat mengedit harga jual IDRX kita.
  ccPriceUsd Float?

  // true ⇒ kartu punya buyback offer AKTIF di CollectorCrypt (param ccBuyback di
  // API mereka). Harga & eksekusi buyback 100% milik CC — kita tidak pernah
  // mengarang nominal buyback untuk kartu vault mereka.
  ccHasBuyback Boolean @default(false)

  // Kapan baris ini terakhir disentuh proses sync CC (created ATAU updated).
  ccSyncedAt DateTime?

  // Penjual: sellerId null utk listing seed/POC; sellerAddress selalu ada (display).
  sellerId      String?
  seller        User?   @relation("ListingSeller", fields: [sellerId], references: [id])
  sellerAddress String

  // Pembeli (ter-set saat SOLD).
  buyerId String?
  buyer   User?   @relation("ListingBuyer", fields: [buyerId], references: [id])

  // Offer records (separate table, bukan JSON lagi)
  offerRecords Offer[]

  // Thread pesan pembeli ↔ penjual untuk listing ini.
  marketThreads MarketThread[]

  // Baris feed aktivitas yang menyebut listing ini.
  activities Activity[]

  // Tautan opsional ke katalog kartu (buat masa depan; POC boleh null).
  cardId String?
  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Restrict)

  // NFT hasil mint on-chain ke wallet buyer setelah listing dibeli.
  nftId String? @unique
  nft   Nft?    @relation("ListingNft", fields: [nftId], references: [id], onDelete: SetNull)

  listedAt  DateTime  @default(now())
  soldAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([sellerId])
  @@index([buyerId])
  @@index([source])
  @@map("listings")
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED // ditolak penjual
  CANCELED // ditarik kembali oleh pembuat offer
}

model Offer {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Pembuat offer. buyerId null hanya untuk baris warisan POC (offer lama
  // disubmit tanpa login, `user` cuma string tampilan). Semua offer baru punya
  // buyerId — itu yang bikin tab "Offers Made"/"Offers Received" bisa nyata.
  buyerId String?
  buyer   User?   @relation("OfferBuyer", fields: [buyerId], references: [id])
  // Label tampilan (displayName / wallet pendek) — snapshot saat offer dibuat.
  user    String

  amount    Int
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId])
  @@index([status])
  @@index([buyerId])
  @@map("offers")
}

// Jenis event yang tampil di feed Activity profil. Nama = label UI,
// ikon dipetakan di frontend (public/activity/*.png).
enum ActivityType {
  OFFER_MADE // shopping_bag_speed
  OFFER_CANCELED // label_off  — ditarik pembuat offer
  OFFER_REJECTED // label_off  — ditolak penjual
  SALE_CARD // sell        — kartu pindah tangan (beli langsung ATAU offer diterima)
  LISTED_CARD // new_label
  LISTING_CANCELED // label_off
  SEND_TO_VAULT // warehouse
  SEND_TO_HOME // delivery_truck_speed
}

// Catatan: TIDAK ada OFFER_ACCEPTED. Offer.status sudah menyimpan penerimaan;
// yang menarik buat feed adalah perpindahan kartunya → SALE_CARD.

/// Satu baris feed aktivitas. Ditulis oleh service saat event terjadi — feed
/// TIDAK direkonstruksi dari status listing (status cuma menyimpan keadaan
/// terakhir, jadi riwayat "pernah listed lalu cancel lalu listed lagi" hilang).
///
/// Field tampilan (itemName/itemImage/category/fromLabel/toLabel) di-snapshot
/// supaya baris riwayat tetap terbaca walau listing/user berubah atau terhapus.
model Activity {
  id   String       @id @default(cuid())
  type ActivityType

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  itemName  String
  itemImage String?
  category  String?
  /// Series/set kartu — snapshot, dipakai filter "All Series" di tab Activity.
  set       String?

  /// IDRX. null = event tanpa nominal (mis. offer dibatalkan → UI render "----").
  amount Int?

  fromId    String?
  from      User?   @relation("ActivityFrom", fields: [fromId], references: [id])
  fromLabel String?

  toId    String?
  to      User?   @relation("ActivityTo", fields: [toId], references: [id])
  toLabel String?

  createdAt DateTime @default(now())

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
  @@index([listingId])
  @@map("activities")
}

model ContactMessage {
  id          String   @id @default(cuid())
  listingId   String?
  listingName String
  senderName  String
  senderEmail String
  phone       String?
  text        String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("contact_messages")
}

// ── Support inbox (user ↔ admin) ─────────────────────────────────────────────
// Beda dari ContactMessage (form kontak anonim 1 arah): ini thread 2 arah yang
// tertaut ke User, jadi balasan admin benar-benar sampai ke user yang login.
enum SupportThreadStatus {
  OPEN
  CLOSED
}

enum SupportSenderType {
  USER
  ADMIN
}

model SupportThread {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String?
  // Opsional: thread yang dibuka dari sebuah listing.
  listingId String?
  status    SupportThreadStatus @default(OPEN)

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, updatedAt])
  @@map("support_threads")
}

model SupportMessage {
  id       String        @id @default(cuid())
  threadId String
  thread   SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderType SupportSenderType
  body       String
  // Flag baca per sisi → dipakai hitung unread di inbox masing-masing.
  readByUser  Boolean @default(false)
  readByAdmin Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("support_messages")
}

// ── Pesan marketplace (pembeli ↔ penjual) ────────────────────────────────────
// Beda dari SupportThread (user↔admin): ini antara DUA user untuk satu listing,
// supaya "Message Seller" benar-benar sampai ke penjual (bukan ke inbox admin).
enum MarketThreadStatus {
  OPEN
  CLOSED
}

enum MarketSenderType {
  BUYER
  SELLER
}

model MarketThread {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  // Satu thread per (listing, pembeli): pembeli membuka percakapan; penjual membalas.
  buyerId String
  buyer   User   @relation("MarketThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId String
  seller   User   @relation("MarketThreadSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  status   MarketThreadStatus @default(OPEN)
  messages MarketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("market_threads")
}

model MarketMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   MarketThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  senderType MarketSenderType
  body       String
  readByBuyer  Boolean @default(false)
  readBySeller Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("market_messages")
}

/// Status siklus hidup satu pembelian pack di gacha CollectorCrypt.
/// Status siklus hidup satu pembelian pack.
///
/// PENTING — "gagal" dan "tidak diketahui" WAJIB dibedakan. submitTransaction milik
/// CollectorCrypt TIDAK idempoten: begitu kita meneruskannya, transaksi bisa saja sudah
/// tayang on-chain walau panggilan kita timeout. Menandai baris seperti itu FAILED =
/// bohong (uang user mungkin sudah keluar) DAN berbahaya (membuka jalan submit ulang →
/// user ditagih 2×). Itulah sebabnya SUBMITTING ada.
enum CcPackStatus {
  GENERATED // transaksi dibuat, belum di-submit — tidak ada uang bergerak, aman ditinggal
  SUBMITTING // sudah diteruskan ke CC, hasilnya BELUM DIKETAHUI → JANGAN submit ulang; rekonsiliasi lewat packStatus
  SUBMITTED // pembelian terkonfirmasi on-chain — uang sudah keluar
  OPENED // pack dibuka, kartu diberikan
  BOUGHT_BACK // kartu dijual balik ke CollectorCrypt (window 72 jam)
  FAILED // HANYA bila kita YAKIN tidak ada uang yang bergerak
}

/// Ledger pembelian pack CollectorCrypt — catatan INDEPENDEN kita atas tiap pack.
/// Ditulis write-ahead (segera setelah generatePack, sebelum uang user bergerak):
/// generatePack tidak memindahkan dana, tapi setelah user menandatangani transaksi
/// TIDAK ADA primitif reverse/hold/release di CollectorCrypt — baris yang hilang =
/// user bayar tanpa jejak, dan komisi 50% yang tak bisa kita tagih. Jadi: roll
/// forward saja (rekonsiliasi via GET /api/pack/status?memo=), jangan pernah rollback.
model CcPackPurchase {
  id String @id @default(cuid())

  /// "slug-uuid" dari CollectorCrypt. Prefix slug = identitas revenue-share kita,
  /// dan @unique bikin retry generate/submit tidak bisa menggandakan baris.
  memo String @unique

  userId String
  /// Restrict (eksplisit): baris ledger tidak boleh yatim gara-gara user dihapus.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Wallet pembayar. SELALU diturunkan dari JWT, TIDAK PERNAH dari request body:
  /// body yang bisa memilih address = penyerang menyuruh korban menandatangani
  /// pembelian yang kartunya mendarat di wallet penyerang.
  playerAddress String

  packType String
  turbo    Boolean      @default(false)
  status   CcPackStatus @default(GENERATED)

  /// Snapshot harga saat generate — USDC base unit (6 desimal), bukan IDR.
  /// Dipakai untuk memverifikasi jumlah on-chain sebelum revenue dibukukan.
  priceUsdc Int?

  purchaseSignature String? // signature tx pembelian
  openSignature     String? // signature tx pengiriman NFT

  /// Tier milik CollectorCrypt (Common|Uncommon|Rare|Epic) — String mentah, JANGAN
  /// dipetakan ke 5-tier Hoshi: "Uncommon" tidak punya padanan dan akan hilang.
  rarity     String?
  nftAddress String?
  nftName    String?
  /// URL gambar kartu, resolusi sama dengan ticker winner:
  /// content.links.image → files[0].cdn_uri → files[0].uri.
  nftImage   String?

  /// Hasil roll VRF on-chain (sumber kebenaran satu-satunya; kita tidak pernah
  /// mengocok ulang secara lokal). String supaya aman dari overflow number JS.
  roll   String?
  points Int?

  buybackAmountUsdc Int? // USDC base unit, dari GET /api/buyback/available
  buybackSignature  String?

  error String? // pesan error terakhir bila FAILED

  /// ── Fakta kartu menurut KATALOG CollectorCrypt (GET /marketplace?search=<nftAddress>) ──
  ///
  /// KENAPA ADA: `nftName` di atas adalah nama METADATA on-chain — dibatasi 32
  /// karakter dan tidak menjamin memuat grade. Menebak grade dengan regex atas nama
  /// itu membuat kartu PSA 10 tampil "Ungraded" di vault sementara marketplace
  /// (yang membaca field terstruktur CC) menampilkan grade sebenarnya.
  ///
  /// SEMUA nullable dan HANYA diisi dari jawaban CC. null = CC belum memberi tahu
  /// kita ⇒ UI menampilkan "belum diketahui" dan listing DITOLAK. Tidak ada nilai
  /// default di sini: kolom kosong itu jujur, kolom tertebak itu bohong.
  ccItemName     String? /// judul katalog LENGKAP (nftName sering terpotong)
  ccGradeCompany String? /// 'PSA' | 'CGC' | 'Beckett' | 'SGC' | … APA ADANYA
  ccGradeScore   Float? /// 10 / 9.5 / 8
  ccGradeLabel   String? /// label mentah, mis. 'GEM-MT 10'
  ccGradeCert    String? /// gradingID (nomor sertifikat)
  ccSet          String?
  ccCategory     String?
  ccLanguage     String?
  ccYear         Int?
  ccVault        String? /// nama vault fisik CC, mis. 'OmniVault'
  ccSerial       String?
  /// Terisi HANYA saat lookup berhasil — penanda "fakta ini nyata, bukan kosong bawaan".
  ccFactsSyncedAt  DateTime?
  /// Percobaan lookup TERAKHIR (berhasil atau tidak) — pembatas retry supaya kartu
  /// yang memang tidak ada di katalog CC tidak dicari ulang tiap request.
  ccFactsAttemptAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  openedAt  DateTime?

  @@index([userId])
  @@index([status])
  @@map("cc_pack_purchases")
}

/// Status siklus hidup satu order pembayaran rupiah (IDRX on-ramp).
///
/// PENTING — PAID berarti "SUDAH DIVERIFIKASI lewat GET /api/transaction/user-transaction-history",
/// BUKAN "callback bilang begitu". Webhook IDRX TIDAK ditandatangani (dokumentasinya menyatakannya
/// terus terang) dan merchantOrderId bukan rahasia — kita sendiri yang menyerahkannya ke frontend
/// supaya user bisa melihat QR-nya. Artinya siapa pun yang tahu URL callback kita bisa mengarang
/// POST "paymentStatus: PAID". Body callback itu PEMICU, bukan BUKTI: satu-satunya field yang boleh
/// dibaca darinya adalah merchantOrderId, dan setiap keputusan uang diambil dari respons History API
/// (syarat lolos: paymentStatus=PAID DAN userMintStatus=MINTED).
///
/// FAILED vs REFUND_DUE dibedakan dengan disiplin yang sama seperti CcPackStatus:
/// FAILED hanya boleh dipakai bila kita YAKIN tidak ada uang user yang tertahan. Begitu rupiah
/// masuk tapi pack tidak bisa diberikan, itu REFUND_DUE — utang, bukan kegagalan yang bisa dilupakan.
enum PaymentStatus {
  PENDING // mint-request dibuat, QR/VA sudah diberikan, user belum bayar
  PAID // TERVERIFIKASI lewat Transaction History API — BUKAN dari callback mentah
  FULFILLING // klaim atomik sudah dimenangkan; treasury sedang membeli pack. Mencegah dobel-pack.
  FULFILLED // pack sudah dibeli & tertaut ke order ini (packMemo terisi)
  EXPIRED // jendela pembayaran habis tanpa pembayaran masuk
  FAILED // gagal, dan kita YAKIN tidak ada uang user yang tertahan
  REFUND_DUE // user SUDAH BAYAR tapi pack tidak bisa diberikan → kita berutang refund
}

/// Buku besar pembayaran rupiah — satu baris per order pack yang dibayar lewat IDRX.
/// Baris inilah GERBANG antara "user login" dan "treasury membelanjakan ~$50 USDC asli":
/// jalur fulfilment WAJIB mengklaim baris ini secara atomik (updateMany berpredikat status,
/// PAID → FULFILLING, lalu cek count === 1) SEBELUM memanggil GachaService.purchase().
/// Tanpa klaim itu, callback yang di-replay / callback yang balapan dengan reconciler akan
/// membeli N pack untuk SATU pembayaran.
model PaymentOrder {
  id String @id @default(cuid())

  /// Dikembalikan oleh IDRX saat mint-request. Kunci join untuk callback DAN rekonsiliasi.
  /// @unique bukan sekadar rapi: keunikan inilah yang memaksa setiap callback palsu, callback
  /// yang diulang, dan dua request yang balapan bertabrakan di SATU baris — supaya satu flip
  /// status atomik bisa menentukan tepat satu pemenang.
  merchantOrderId String @unique

  /// Field `id` milik IDRX (bukan punya kita) — disimpan untuk jejak audit / support.
  idrxRequestId String?
  reference     String?

  userId String
  /// Restrict (eksplisit): baris pembayaran tidak boleh yatim gara-gara user dihapus.
  /// Riwayat uang tidak ikut terhapus bersama akun.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Snapshot saat order dibuat. Saat fulfilment, packType diambil dari SINI dan tidak pernah
  /// dari input client — kalau tidak, user bisa memesan pack murah lalu menebus pack mahal.
  packType String

  /// Yang dibayar user, rupiah penuh sebagai integer. JANGAN float (uang tidak boleh dibulatkan
  /// oleh IEEE-754). Int aman di sini: mint-request IDRX dibatasi maks Rp 1.000.000.000 per
  /// transaksi, di bawah plafon Int 2.147.483.647.
  priceIdr Int

  /// Snapshot harga mesin CollectorCrypt saat order dibuat — USDC base unit (6 desimal), BUKAN
  /// rupiah. Dua kolom uang di baris ini memakai satuan yang berbeda; jangan pernah dibandingkan
  /// satu sama lain. Snapshot ini yang jadi plafon harga saat pack ditebus, supaya pergerakan
  /// harga CC antara "user bayar" dan "kita tebus" tidak diam-diam ditanggung treasury.
  priceUsdc Int

  /// QRIS | VA | HOSTED (alur hosted IDRX = paymentUrl, mencakup QRIS + e-wallet + VA + retail).
  paymentMethod    String
  qrContent        String?
  virtualAccountNo String?
  paymentUrl       String?

  /// Diturunkan dari expiryPeriod IDRX. Pembayaran yang mendarat setelah ini berarti snapshot
  /// harganya sudah basi — jangan di-fulfil otomatis.
  expiresAt DateTime?

  status PaymentStatus @default(PENDING)

  /// Nilai MENTAH dari IDRX, disimpan apa adanya untuk audit — bukan untuk dipakai sebagai
  /// gerbang. Gerbangnya adalah kolom `status` di atas, yang cuma boleh diubah setelah
  /// verifikasi server-to-server.
  idrxPaymentStatus  String? // PAID | WAITING_FOR_PAYMENT | EXPIRED
  idrxUserMintStatus String? // NOT_AVAILABLE | PROCESSING | MINTED | FAILED | REJECTED | REFUND

  /// Signature transaksi mint IDRX di Solana (IDRX masuk ke treasury).
  txHash String?

  /// Tautan ke CcPackPurchase.memo. @unique = SATU ORDER, SATU PACK, SELAMANYA — ini invariant
  /// terakhir yang menahan uang kita: kalaupun semua pengaman di atas bocor dan fulfilment
  /// dijalankan dua kali untuk satu pembayaran, INSERT/UPDATE kedua tabrakan di unique index ini
  /// dan Postgres yang menolaknya. Klaim atomik mencegah pack kedua dibuat; @unique membuktikan
  /// setelahnya bahwa memang tidak pernah ada pack kedua.
  packMemo String? @unique

  /// Order MARKETPLACE (reseller kartu CC): id Listing yang dibeli. null = order pack gacha.
  /// Saat fulfilment, `listingId != null` mengarahkan ke jalur settlement RESELLER (treasury
  /// beli kartu di CollectorCrypt lalu men-transfer-nya ke pembeli) — BUKAN gacha.purchase().
  /// Untuk order ini `packType` di-set sentinel "MARKETPLACE" dan `packMemo` tetap null;
  /// invariant "satu order satu penjualan" ditegakkan oleh flip atomik Listing ACTIVE→SOLD.
  listingId String?

  /// Pesan error terakhir. JANGAN pernah menuliskan kredensial IDRX ke sini.
  error String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  fulfilledAt DateTime?

  /// Reconciler memindai order yang menggantung berdasarkan status — callback IDRX tidak pernah
  /// diulang, jadi polling inilah sumber kebenaran yang sebenarnya.
  @@index([status])
  @@index([userId])
  @@index([listingId])
  @@map("payment_orders")
}

/// Siklus hidup satu swap IDRX → USDC.
///
/// Pembagiannya mengikuti satu pertanyaan: APAKAH SUDAH ADA TRANSAKSI YANG DIKIRIM KE JARINGAN?
/// Sebelum dikirim, kegagalan itu murah (tidak ada dana bergerak) dan boleh diulang. Sesudah
/// dikirim, "gagal" TIDAK sama dengan "tidak terjadi apa-apa" — transaksi bisa mendarat detik
/// berikutnya, jadi mengulanginya berarti menukar dua kali.
enum TreasurySwapStatus {
  QUOTED /// baris write-ahead sudah ditulis, BELUM ada transaksi dikirim. Aman diulang.
  SUBMITTED /// transaksi SUDAH dikirim ke jaringan. JANGAN PERNAH diulang otomatis.
  CONFIRMED /// terkonfirmasi on-chain; USDC benar-benar masuk ke treasury
  FAILED /// terbukti gagal SEBELUM transaksi dikirim — tidak ada dana yang bergerak
  NEEDS_CHECK /// sudah dikirim tapi hasilnya tidak terbaca → WAJIB diperiksa manusia
}

/// Buku besar swap treasury IDRX → USDC.
///
/// KENAPA ADA: rupiah user masuk ke treasury sebagai IDRX, sedangkan pack dibayar dengan USDC.
/// Tanpa jalur yang menutup lingkaran itu, saldo USDC turun tiap penjualan dan tidak pernah naik.
/// Tabel ini adalah jejak audit satu-satunya untuk uang yang berpindah bentuk di dalam dompet kita
/// sendiri — tidak ada order user yang bisa dipakai merekonstruksinya.
///
/// Baris ditulis WRITE-AHEAD (status QUOTED) SEBELUM transaksi ditandatangani, dengan alasan yang
/// sama seperti CcPackPurchase: sesudah submit, satu-satunya jalan yang jujur adalah ROLL FORWARD.
model TreasurySwap {
  id String @id @default(cuid())

  /// IDRX base unit (2 DESIMAL — Rp 448.353 = 44.835.300). BigInt, bukan Int: Rp 1 miliar
  /// (batas mint IDRX) = 100.000.000.000 base unit, jauh di atas plafon Int 2.147.483.647.
  idrxBaseUnits BigInt

  /// USDC base unit (6 desimal) yang DIPERKIRAKAN kuotasi. Perkiraan, bukan janji.
  quotedUsdcBaseUnits BigInt

  /// Batas bawah yang DITEGAKKAN ON-CHAIN (otherAmountThreshold Jupiter). Kalau eksekusi
  /// menghasilkan kurang dari ini, transaksinya GAGAL — bukan diam-diam menerima harga buruk.
  minUsdcBaseUnits BigInt

  /// Yang BENAR-BENAR diterima, dibaca dari saldo setelah konfirmasi. Null selama belum pasti.
  receivedUsdcBaseUnits BigInt?

  /// Kurs efektif kuotasi (rupiah per USDC, dibulatkan) — disimpan supaya spread terhadap
  /// kuotasi IDRX bisa dipantau lintas waktu tanpa menghitung ulang dari base unit.
  rateIdrPerUsdc Int?

  /// Price impact kuotasi dalam bps. Inilah biaya likuiditas yang kita bayar.
  priceImpactBps Int?

  /// Toleransi slippage yang diminta ke Jupiter saat kuotasi dibuat.
  slippageBps Int

  /// Signature transaksi swap. @unique: kalaupun ada dua jalur yang entah bagaimana
  /// mengirim transaksi yang sama, hanya satu baris yang bisa mencatatnya.
  signature String? @unique

  status TreasurySwapStatus @default(QUOTED)

  /// Pesan kegagalan terakhir. JANGAN pernah menuliskan secret key ke sini.
  error String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  confirmedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("treasury_swaps")
}

/// Kunci single-flight untuk swap treasury — SATU baris saja (id = "singleton").
///
/// Scheduler punya penjaga in-process, tapi itu hanya berlaku dalam SATU proses. Begitu ada dua
/// instance (atau satu deploy yang tumpang tindih dengan instance lama), dua penyapu bisa
/// menguotasi saldo IDRX yang sama dan mengirim dua transaksi. Klaim atomik di baris ini —
/// updateMany berpredikat, lalu cek count === 1 — adalah pola yang sama dengan klaim PaymentOrder,
/// dan aman di bawah connection pooling (beda dari advisory lock yang terikat sesi).
model TreasurySwapLock {
  id String @id

  /// Null = bebas. Terisi = ada yang memegang. Pemegang yang mati ditangani lewat batas usia
  /// (lihat TreasurySwapService) — kunci yang tidak pernah bisa basi = swap berhenti selamanya.
  lockedAt DateTime?

  /// Identitas pemegang, untuk log. Hanya pemegang yang sama yang boleh melepas.
  lockedBy String?

  @@map("treasury_swap_lock")
}
