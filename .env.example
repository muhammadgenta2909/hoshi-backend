# ===== Hoshi Backend — copy ke .env lalu isi =====

# --- Database (Neon / PostgreSQL) ---
# Buat DB gratis di https://neon.tech → copy connection string ke sini.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth (JWT) ---
# Generate (min 32 char): openssl rand -hex 32
JWT_SECRET=change-me-min-32-chars-pakai-openssl-rand-hex-32
# Durasi token, WAJIB bersatuan: 7d / 12h / 30m
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=3001
# Origin frontend yang boleh akses (CORS). Bisa lebih dari satu, pisahkan koma.
FRONTEND_ORIGIN=http://localhost:3000

# --- Solana (devnet) ---
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Secret keypair platform sebagai JSON byte array (isi platform.json). JANGAN commit.
# Generate: solana-keygen new --outfile platform.json
# Fund:     solana airdrop 2 $(solana-keygen pubkey platform.json) --url devnet
PLATFORM_SECRET_KEY=[12,34,...]
# URL metadata JSON default saat mint (fallback bila card belum punya metadataUri).
DEFAULT_METADATA_URI=https://gateway.irys.xyz/<id>
