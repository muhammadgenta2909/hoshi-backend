# ─────────────────────────────────────────────────────────────
# Hoshi Backend — contoh environment. Salin ke .env lalu isi nilai asli.
#   cp .env.example .env
# Divalidasi saat boot oleh src/config/env.validation.ts (fail fast).
# ─────────────────────────────────────────────────────────────

# WAJIB — koneksi PostgreSQL yang dipakai aplikasi saat runtime.
# Di Neon: pakai connection string POOLED (host ber-sufiks `-pooler`), + ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hoshi?schema=public"

# WAJIB — koneksi DIRECT (unpooled) khusus untuk `prisma migrate deploy`.
# Migration menjalankan DDL + advisory lock, yang bisa menggantung lewat PgBouncer.
# Di Neon: connection string tanpa sufiks `-pooler`.
# Di lokal (satu Postgres biasa) cukup samakan dengan DATABASE_URL:
DIRECT_URL="${DATABASE_URL}"

# WAJIB — secret JWT (HS256), minimal 32 karakter. Generate:
#   openssl rand -hex 32   (atau: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="ganti-dengan-hasil-openssl-rand-hex-32-minimal-32-karakter"

# Opsional — masa berlaku token (default 7d). Harus bersatuan: 7d / 30m / 12h.
JWT_EXPIRES_IN="7d"

# Opsional — port HTTP (default 3001).
PORT=3001

# Opsional — origin frontend untuk CORS (boleh banyak, dipisah koma; default http://localhost:3000).
FRONTEND_ORIGIN="http://localhost:3000"

# Opsional — RPC Solana (default clusterApiUrl('devnet')).
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Opsional — nama cluster untuk link explorer (default devnet).
SOLANA_CLUSTER="devnet"

# Opsional (WAJIB kalau mau mint NFT) — secret key keypair platform sebagai
# JSON byte array, isi platform.json. Platform ini yang membayar biaya mint.
# Generate keypair devnet: solana-keygen new -o platform.json
#   lalu isi: PLATFORM_SECRET_KEY=[12,34,...]
PLATFORM_SECRET_KEY=

# Opsional — metadata URI default saat card belum punya metadataUri sendiri.
DEFAULT_METADATA_URI="https://gateway.irys.xyz/6UNWfKd2igXWUGF7XY39Mwa7baeVwFHVdorDCaH1bjN2"

# ─────────────────────────────────────────────────────────────
# Open Packs — sumber inventory kartu (fitur gacha).
# ─────────────────────────────────────────────────────────────
# Opsional — sumber default: hoshi-vault | collectorcrypt | mock (default hoshi-vault).
#   hoshi-vault   → tarik dari vault Hoshi sendiri, mint NFT (butuh PLATFORM_SECRET_KEY)
#   mock          → pool sintetis in-memory, tanpa DB/chain (dev frontend & test)
#   collectorcrypt→ tarik dari API CollectorCrypt (butuh 2 var di bawah)
INVENTORY_PROVIDER="hoshi-vault"

# Opsional (WAJIB kalau INVENTORY_PROVIDER=collectorcrypt) — kredensial API CollectorCrypt.
# Verifikasi base URL & path endpoint ke docs.collectorcrypt.com saat integrasi.
COLLECTORCRYPT_API_BASE_URL=
COLLECTORCRYPT_API_KEY=

# ─────────────────────────────────────────────────────────────
# Katalog publik CollectorCrypt Marketplace (sync produk → marketplace kita).
# ─────────────────────────────────────────────────────────────
# Opsional — base URL API katalog PUBLIK mereka (tanpa API key, read-only).
# Dipakai POST /api/admin/cc-sync untuk menarik kartu ter-vault CC menjadi
# listing source=COLLECTORCRYPT. Default sudah benar; jarang perlu diubah.
COLLECTORCRYPT_MARKET_BASE_URL="https://api.collectorcrypt.com"

# Opsional — kurs USD→IDR untuk harga AWAL listing hasil sync (harga CC × kurs).
# Re-sync tidak pernah menyentuh harga: setelah baris tercipta, harga milik
# admin ("kita tinggal edit harga di atas katalog mereka"). Default 16000.
HOSHI_USD_IDR_RATE="16000"

# Gacha CollectorCrypt (modul baru, terpisah dari inventory provider di atas).
# ─────────────────────────────────────────────────────────────
# Opsional (WAJIB kalau fitur gacha dipakai) — base URL API gacha.
#   devnet   → https://dev-gacha.collectorcrypt.com
#   produksi → https://gacha.collectorcrypt.com
# Beda satu hostname, tapi yang satu memindahkan USDC ASLI. Jangan tertukar.
COLLECTORCRYPT_GACHA_BASE_URL="https://dev-gacha.collectorcrypt.com"

# Opsional (WAJIB kalau fitur gacha dipakai) — API key dari partner onboarding
# CollectorCrypt. Dikirim sebagai header `x-api-key` (BUKAN bearer token).
# Key ini menurunkan `slug` kita → jadi prefix memo tiap transaksi → dasar bagi
# hasil 50%. RAHASIA: server-side saja, jangan pernah dikirim ke browser.
COLLECTORCRYPT_GACHA_API_KEY=

# ── Katalog mesin (GROUND TRUTH devnet, diamati langsung dari GET /api/machines) ──
# Dokumentasi CC hanya pernah menyebut DUA mesin; live devnet ternyata ada DELAPAN.
# Mesin default aplikasi (DEFAULT_PACK_TYPE) = pokemon_50. `code` di kiri inilah yang
# dikirim sebagai packType:
#   pokemon_25   $25     pokemon_50    $50     pokemon_cnft  $50      sweet_99     $99
#   sports_100   $100    pokemon_250   $250    onepiece_250  $250     pokemon_1000 $1000
#
# PENTING — SATUAN HARGA (bug yang benar-benar pernah terjadi). GET /api/machines melaporkan
# `price` dalam DOLAR USDC PENUH (pokemon_50 → 50, pokemon_1000 → 1000), BUKAN base units:
# CC TIDAK PERNAH mengirim 50_000_000. Backend mengonversinya ke USDC base units (6 desimal)
# TEPAT SEKALI di boundary klien (CcGachaClient.machines(): round(dollars × 1_000_000)),
# supaya tidak ada service hilir yang keliru memperlakukan 50 sebagai base units lalu menagih
# user Indonesia ~Rp 0,04 untuk pack $50. Konsekuensinya: SEMUA plafon di bawah, dan semua
# kolom harga di DB, memakai BASE UNITS — bukan dolar.

# ─────────────────────────────────────────────────────────────
# Treasury Hoshi — dompet yang MEMBAYAR setiap pack gacha.
# ─────────────────────────────────────────────────────────────
# Opsional saat boot (WAJIB kalau gacha treasury dipakai) — secret key keypair
# treasury sebagai JSON byte array, format sama dengan PLATFORM_SECRET_KEY.
# Generate: solana-keygen new -o treasury.json
#   lalu isi: HOSHI_TREASURY_SECRET_KEY=[12,34,...]
#
# DOMPET INI MEMEGANG USDC ASLI. User Indonesia bayar rupiah dan tidak punya
# USDC/SOL sama sekali, jadi treasury inilah yang jadi `playerAddress` di
# CollectorCrypt: ia yang membayar ~$50 per pack DAN yang menandatangani
# transaksinya server-side. Wallet user cuma jadi `altPlayerAddress` (penerima kartu).
#
# INI SECRET PALING SENSITIF DI SELURUH SISTEM. Siapa pun yang bisa membacanya —
# lewat RCE, dependency jahat, console.log(process.env), dashboard hosting, atau
# backup yang bocor — bisa menguras seluruh USDC + SOL treasury, seketika dan
# tidak bisa ditarik kembali. Aturannya:
#   - JANGAN pernah pakai key yang sama dengan PLATFORM_SECRET_KEY (blast radius beda).
#   - Simpan hanya "float" secukupnya di dompet panas ini, sisanya di cold wallet.
#   - Jangan pernah di-commit, di-log, atau dikirim ke browser.
HOSHI_TREASURY_SECRET_KEY=

# WAJIB kalau treasury dipakai — alamat PUBLIK (base58) dari keypair di atas.
# Cek: solana-keygen pubkey treasury.json
#
# HARUS wallet yang SAMA dengan HOSHI_TREASURY_SECRET_KEY. Nilai ini dipakai sebagai
# tujuan mint IDRX (ke mana rupiah user mendarat), sedangkan pack ditandatangani oleh
# secret key di atas. Kalau keduanya beda wallet — mis. env belum di-update setelah
# rotasi key — IDRX mencetak ke wallet A tapi treasury bayar dari wallet B: rugi diam-diam
# tiap pack. Backend MENOLAK jalan kalau keduanya tidak cocok (bukan cuma peringatan).
HOSHI_TREASURY_ADDRESS=

# Opsional — plafon harga SATU pack yang treasury bersedia tandatangani.
# SATUAN: USDC BASE UNITS (6 desimal), BUKAN dolar. 100000000 = $100. Default: 100000000.
# CollectorCrypt melaporkan harga mesinnya dalam DOLAR PENUH (mis. pokemon_50 → 50); backend
# mengonversinya ke base units di boundary klien SEBELUM dibandingkan dengan plafon ini — jadi
# nilai di sini WAJIB base units. Kalau salah ditulis sebagai dolar (mis. 100), plafonnya
# meleset 1.000.000× dan tidak lagi menahan apa pun.
# Harga pack di-snapshot dari GET /api/machines milik CollectorCrypt, artinya nominal
# yang kita bayar ditentukan RESPONS MEREKA — dan di jalur treasury sudah tidak ada
# popup wallet yang menahannya. Plafon ini yang memastikan satu respons harga yang
# jahat atau salah tidak berubah jadi tanda tangan treasury puluhan ribu dolar.
GACHA_MAX_PACK_PRICE_USDC=100000000

# Opsional — plafon belanja treasury dalam 24 jam berjalan.
# SATUAN: USDC BASE UNITS (6 desimal), BUKAN dolar. 500000000 = $500. Default: 500000000.
# Sama seperti plafon per-pack di atas: harga mesin CC yang dolar-penuh sudah dikonversi ke
# base units di boundary klien, jadi perbandingannya base-unit-vs-base-unit — jangan isi dolar.
#
# BACA INI SEBELUM MENAIKKANNYA. Selama gerbang pembayaran rupiah (IDRX/PSP) belum ada,
# angka ini adalah SATU-SATUNYA batas nominal antara seorang user login dan seluruh isi
# treasury: POST /api/gacha/packs/purchase membelanjakan ~$50 USDC ASLI tiap dipanggil,
# dan satu-satunya syaratnya cuma "punya JWT yang sah". JWT itu gratis dan tak terbatas —
# /auth/nonce meng-upsert user untuk alamat Solana APA PUN, jadi ribuan akun bisa dibuat
# dalam hitungan detik dan rate-limit per-user tidak menutup lubangnya.
#
# Setel serendah mungkin, dan isi dompet panas treasury hanya sebesar plafon ini.
GACHA_TREASURY_DAILY_CAP_USDC=500000000

# ─────────────────────────────────────────────────────────────
# IDRX — on-ramp rupiah. Inilah gerbang yang bikin pack tidak lagi gratis:
# user bayar QRIS/VA/e-wallet → IDRX mint IDRX ke treasury Solana kita →
# baru treasury membelanjakan USDC untuk pack-nya.
# Semua opsional saat boot; app tetap start tanpa ini (fitur pembayaran yang mati,
# bukan seluruh deploy).
# ─────────────────────────────────────────────────────────────
# Opsional — base URL API IDRX. Default: https://idrx.co
IDRX_API_BASE="https://idrx.co"

# Opsional (WAJIB kalau pembayaran rupiah dipakai) — API key dari dashboard IDRX
# (butuh akun bisnis + KYC terverifikasi). Dikirim sebagai header `idrx-api-key`.
IDRX_API_KEY=

# Opsional (WAJIB kalau pembayaran rupiah dipakai) — secret HMAC-SHA256, formatnya
# BASE64 (di-decode dulu sebelum dipakai sebagai kunci HMAC — lihat
# src/idrx/idrx.signature.ts, jangan diubah encoding-nya).
#
# SETELAH HOSHI_TREASURY_SECRET_KEY, INI NILAI PALING SENSITIF DI SISTEM.
# Dengan key ini orang lain bisa menandatangani mint-request atas nama merchant kita
# dan membaca seluruh riwayat transaksi kita. Aturannya sama: jangan di-commit,
# jangan di-log, jangan pernah masuk ke pesan error atau respons API.
IDRX_API_SECRET=

# Opsional (WAJIB kalau pembayaran rupiah dipakai) — chain id Solana versi IDRX.
# Nilainya diberikan saat onboarding IDRX — JANGAN ditebak: salah chain berarti IDRX
# ter-mint di jaringan lain dan treasury Solana kita tidak pernah menerimanya,
# padahal user sudah membayar.
IDRX_NETWORK_CHAIN_ID=

# Opsional — margin Hoshi dalam basis point ("500" = 5%). Ditambahkan di atas harga
# pack (hasil konversi USDC→IDR lewat GET /api/transaction/rates) plus biaya QRIS,
# sebelum jadi nominal rupiah yang dibayar user.
#
# KEPUTUSAN SAAT INI: "0" — kita TIDAK menaikkan harga di atas harga CollectorCrypt.
# Pendapatan Hoshi murni dari bagi hasil 50%. Biaya QRIS (0,7%) tetap diteruskan ke user
# (bukan margin, tapi pass-through biaya) — itu sudah disepakati dengan Joe.
HOSHI_PACK_MARGIN_BPS="0"

# Opsional (WAJIB kalau pembayaran rupiah dipakai) — channel id QRIS dari IDRX.
# Dibutuhkan untuk alur DIRECT payment (paymentMethod=QRIS) supaya IDRX mengembalikan
# `qrContent` yang bisa langsung dirender jadi QR. Nilainya dari onboarding IDRX.
IDRX_QRIS_CHANNEL_ID=

# Opsional (WAJIB kalau pembayaran rupiah dipakai) — URL frontend tempat user
# dikembalikan setelah hosted checkout IDRX. JANGAN dijadikan bukti pembayaran:
# user bisa menutup browser. Kebenaran pembayaran HANYA dari Transaction History API.
HOSHI_PAYMENT_RETURN_URL=

# Opsional — jendela bayar QR (menit). Default 30.
# Sengaja jauh lebih pendek dari default IDRX (120): makin lama QR hidup, makin jauh
# kurs bisa bergeser antara saat kita mengunci harga rupiah dan saat user benar-benar
# membayar — selisihnya kita yang menanggung, di setiap pack.
HOSHI_ORDER_EXPIRY_MINUTES="30"

# Opsional — maksimum order menganggur per user. Default 3.
HOSHI_MAX_OPEN_ORDERS="3"

# ─────────────────────────────────────────────────────────────────────────────
# Upload gambar listing (admin). OPSIONAL tapi WAJIB di produksi.
# Kalau di-set, foto listing manual diunggah ke Cloudinary dan disimpan sebagai
# URL CDN absolut. Kalau KOSONG, upload jatuh ke disk lokal (ephemeral, hilang
# tiap redeploy di Render) — hanya untuk dev lokal, JANGAN dipakai di produksi.
# Isi SALAH SATU cara (A atau B) — jangan perlu dua-duanya.
#
# CARA A (1 baris). Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Contoh: CLOUDINARY_URL=cloudinary://123456789012345:abcXYZsecret@dh7kplm2q
CLOUDINARY_URL=
#
# CARA B (3 baris) — pakai ini kalau dashboard cuma menampilkan nilai terpisah.
# Cari di Cloudinary: Settings (⚙️) → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
