# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.local
.env.*.local
# Backup .env berisi secret yang SAMA persis dengan .env — tanpa baris ini,
# satu `git add -A` yang tidak sengaja akan mem-publish JWT secret, kredensial DB,
# API key CollectorCrypt, dan private key treasury sekaligus.
.env.backup*
.env.bak

# Keypair treasury: private key dompet yang MEMEGANG USDC dan membayar setiap pack.
# Ini file paling berbahaya di repo — siapa pun yang memilikinya bisa menguras treasury.
# (platform.json sudah di-ignore di bawah; treasury.json levelnya lebih tinggi lagi.)
treasury.json

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports
report.*.json

# Solana platform keypair (JANGAN commit — berisi secret key)
platform.json

# Admin image uploads (multer, dibuat otomatis via fs.mkdirSync).
# JANGAN commit: berisi file user, dan di host free tier (Render) filesystem-nya
# ephemeral sehingga isinya hilang tiap redeploy. Ganti ke object storage
# (Cloudinary/Supabase Storage) kalau perlu persisten.
uploads/

# Agent tooling; not part of the service.
.agents/
agent/
skills-lock.json
